{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "inventory": {
            "root": ".",
            "runtime": "container",
            "entrypoint": "Dockerfile.vercel"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": {
                "service": "inventory"
            }
        }
    ]
}
